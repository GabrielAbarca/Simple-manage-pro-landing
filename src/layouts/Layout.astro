---
import "../styles/tokens.css";
import "../styles/globals.css";
import "../styles/buttons.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Toast from "../components/ui/Toast.astro";
import { SITE_NAME } from "../config";

interface Props {
  /** Keyword-led and page-specific. The brand is appended, so leave it out. */
  title: string;
  description: string;
  /** Absolute-from-root path, e.g. "/og-piloto.png". Defaults to the home card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Set false when the title already ends in the brand. */
  brandInTitle?: boolean;
  /** Reveal timing profile (src/scripts/core/reveal.ts). */
  revealProfile?: "page" | "contacto" | "home";
  /** Pages with live UI that confirms an action ("Guardado.", "Copiado."). */
  withToast?: boolean;
}

const {
  title,
  description,
  ogImage = "/og.png",
  ogImageAlt = "Simple Manage Pro, el sistema con el que su colegio lleva el curso lectivo.",
  ogType = "website",
  brandInTitle = true,
  revealProfile = "page",
  withToast = false,
} = Astro.props;

const fullTitle = brandInTitle ? `${title} | ${SITE_NAME}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The OG card is a first-class deliverable, not metadata: directors forward
// this link in WhatsApp, which renders a preview, so the card is the first
// impression for a second reader who never spoke to Gabriel. See BRIEF §8.
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* The app's own icon set, copied rather than relinked: the landing page
        is a separate Vercel project on the apex domain, so it cannot reach
        the demo subdomain's /public.

        The 48, 96 and 192 PNGs are linked as icons here, not left to the
        manifest alone. Google wants a Search favicon that is a square multiple
        of 48px and ignores the manifest when choosing one, so without these
        lines its only rel="icon" candidates top out at 32 (the .ico) and it
        falls back to the apple-touch-icon. 48 and 96 give it a clean direct
        match so it never has to downscale the 192 heavily; all three derive
        from the 512px source. Ordered small to large. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f6f9" />

    {/* Only the weights that render above the fold. 800 is the display head
        and the logotype, 600 the nav and pills, 400 the lede. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-600-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-800-normal.woff2"
      crossorigin
    />

    {/* Set before first paint. `js` arms the scripted surfaces (3D stages,
        menu button); `motion` arms the reveal start states and the Home intro,
        and is withheld under prefers-reduced-motion so those pages render in
        their final state instead of animating to it. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("motion");
      })();
    </script>

    {/* Prefetch the next route on hover/pointerdown so a director clicking
        through the site never waits on a fresh document. Same-origin only:
        "/*" never matches the demo/legal origins, which must not be
        prefetched. A pure hint, ignored where unsupported and inert with
        JavaScript disabled, so the no-JS render is unaffected. */}
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          { "where": { "href_matches": "/*" }, "eagerness": "moderate" }
        ]
      }
    </script>

    {/* Per-page structured data and any other head extras. */}
    <slot name="head" />
  </head>
  <body data-reveal-profile={revealProfile}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {withToast && <Toast />}

    {/* Vercel Web Analytics and Speed Insights. Both are cookie-free, so there
        is no consent banner and nothing to explain under Ley 8968 (BRIEF §9).

        Deliberately here and not in <head>: each renders a custom element, and
        an unknown element in <head> ends head parsing, which would reparent
        the gate script and the JSON-LD slot into <body>. */}
    <Analytics />
    <SpeedInsights />

    <script>
      import { initReveal, REVEAL_PROFILES } from "../scripts/core/reveal";
      const profileName = document.body.dataset.revealProfile ?? "page";
      initReveal(REVEAL_PROFILES[profileName] ?? REVEAL_PROFILES.page);
    </script>
  </body>
</html>
