---
import Layout from "../layouts/Layout.astro";
import PilotoHero from "../components/piloto/PilotoHero.astro";
import PilotoAudience from "../components/piloto/PilotoAudience.astro";
import PilotoOffer from "../components/piloto/PilotoOffer.astro";
import PilotoCalendar from "../components/piloto/PilotoCalendar.astro";
import PilotoApply from "../components/piloto/PilotoApply.astro";
import PilotoFaq from "../components/piloto/PilotoFaq.astro";
import { breadcrumbLd, faqLd } from "../lib/schema";
import { faqCopy, pilotoMeta } from "../data/piloto";

const jsonLd = [breadcrumbLd(pilotoMeta.breadcrumb, "/piloto/"), faqLd(faqCopy.items)];
---

<Layout title={pilotoMeta.title} description={pilotoMeta.description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PilotoHero />
  <PilotoAudience />
  <PilotoOffer />
  <PilotoCalendar />
  <PilotoApply />
  <PilotoFaq />
</Layout>

<script>
  import { initPilotoPage } from "../scripts/piloto/page";
  initPilotoPage();
</script>
