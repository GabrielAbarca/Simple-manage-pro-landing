---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeSecurity from "../components/home/HomeSecurity.astro";
import HomeContact from "../components/home/HomeContact.astro";
import { DEMO_URL, EMAIL, SITE_NAME, WHATSAPP } from "../config";
import { homeMeta } from "../data/home";

const site = Astro.site?.origin ?? "https://simplemanagepro.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: SITE_NAME,
      url: site,
      logo: `${site}/android-chrome-512x512.png`,
      email: EMAIL,
      areaServed: { "@type": "Country", name: "Costa Rica" },
      founder: { "@type": "Person", name: "Gabriel Zelaya" },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        telephone: `+${WHATSAPP}`,
        email: EMAIL,
        areaServed: "CR",
        availableLanguage: "Spanish",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: SITE_NAME,
      inLanguage: "es-CR",
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site}/#software`,
      name: SITE_NAME,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      inLanguage: "es",
      url: site,
      publisher: { "@id": `${site}/#organization` },
      description:
        "Sistema de gestión escolar para colegios de Costa Rica: notas, asistencia, horarios y expedientes, con portales para la dirección, los docentes y los estudiantes.",
      featureList: [
        "Curso lectivo y periodos",
        "Niveles, secciones y aulas",
        "Importación de documentos desde Excel",
        "Libro de notas con categorías ponderadas",
        "Asistencia por sección",
        "Informe de progreso imprimible",
        "Portal del estudiante",
      ],
      softwareHelp: DEMO_URL,
    },
  ],
};
---

<Layout title={homeMeta.title} description={homeMeta.description} revealProfile="home">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <HomeHero />
  <HomeSecurity />
  <HomeContact />
</Layout>

<script>
  import { initHomePage } from "../scripts/home/page";
  initHomePage();
</script>
