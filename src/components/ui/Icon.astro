---
// The DS <Icon>: one Material Symbols path painted inline, so a glyph never
// waits on a sprite request. Decorative by contract (aria-hidden); the
// control or text beside it carries the meaning.
import type { HTMLAttributes } from "astro/types";
import { ICON_PATHS, type IconName } from "./icons";

interface Props extends Omit<HTMLAttributes<"svg">, "width" | "height" | "viewBox"> {
  name: IconName;
  /** Any CSS length, or a number of px. Matches the DS default of 1.2rem. */
  size?: string | number;
  /** Omit to inherit currentColor from the surrounding text. */
  color?: string;
}

const { name, size = "1.2rem", color, class: className, style: callerStyle, ...rest } = Astro.props;

const colorDeclaration = color ? `color:${color}` : "";
const callerStyleDeclaration = typeof callerStyle === "string" ? callerStyle : "";
const inlineStyle = [colorDeclaration, callerStyleDeclaration].filter(Boolean).join(";") || undefined;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 -960 960 960"
  aria-hidden="true"
  focusable="false"
  style={inlineStyle}
  {...rest}
  set:html={ICON_PATHS[name]}
/>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
