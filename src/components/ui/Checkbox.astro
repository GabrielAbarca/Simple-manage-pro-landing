---
// The DS <Checkbox>: a bordered row, not a bare box, so a multi-select grid
// reads at a glance. The checked tint follows the real input through
// :has(:checked), so no script ever has to mirror state onto the row.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"label"> {
  /** Visible text. A default slot replaces it when the label needs markup. */
  label?: string;
  name?: string;
  value?: string;
  id?: string;
  checked?: boolean;
  required?: boolean;
  disabled?: boolean;
  /**
   * 44px tall with wider side padding: the prototypes' grid rows, where each
   * box is a touch target of its own.
   */
  tapTarget?: boolean;
  /**
   * No border, tint or padding, line-height 1.5: the prototypes' consent
   * line, where a framed row would read as one more option to pick. Pair it
   * with tapTarget to keep the consent line's 44px height.
   */
  borderless?: boolean;
  /** Any other attribute for the <input> itself, e.g. aria-describedby. */
  inputAttributes?: HTMLAttributes<"input">;
}

const {
  label,
  name,
  value,
  id,
  checked = false,
  required,
  disabled = false,
  tapTarget = false,
  borderless = false,
  inputAttributes = {},
  class: className,
  ...rest
} = Astro.props;
---

<label
  class:list={["checkbox-row", className]}
  data-tap-target={tapTarget ? "true" : undefined}
  data-borderless={borderless ? "true" : undefined}
  {...rest}
>
  <input
    type="checkbox"
    id={id}
    name={name}
    value={value}
    checked={checked}
    required={required}
    disabled={disabled}
    {...inputAttributes}
  />
  <span><slot>{label}</slot></span>
</label>

<style>
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    line-height: normal;
    color: var(--color-dark);
    cursor: pointer;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border-control);
    background: transparent;
    border-radius: var(--border-radius-2);
    transition: border-color var(--transition-speed) ease;
    opacity: 1;
  }

  .checkbox-row:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .checkbox-row:has(input:disabled) {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .checkbox-row[data-tap-target="true"] {
    min-height: 44px;
    box-sizing: border-box;
    padding: 0.35rem 0.75rem;
  }

  .checkbox-row[data-borderless="true"],
  .checkbox-row[data-borderless="true"]:has(input:checked) {
    border: none;
    background: transparent;
    padding: 0;
    line-height: 1.5;
  }

  input {
    accent-color: var(--color-primary);
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin: 0;
    cursor: inherit;
  }

  input:focus-visible {
    outline: var(--focus-outline);
    outline-offset: 2px;
  }
</style>
