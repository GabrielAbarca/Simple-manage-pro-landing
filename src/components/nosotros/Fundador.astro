---
import Eyebrow from "./Eyebrow.astro";
import { founderCopy } from "../../data/nosotros";
---

<section class="founder" data-screen-label="04 Fundador" data-rv>
  <div class="card">
    <div class="identity">
      <Eyebrow label={founderCopy.eyebrow} />
      <div class="name-row">
        <span class="avatar" data-fade aria-hidden="true">{founderCopy.initials}</span>
        <div class="name-stack">
          <h2>
            <span class="line-mask"><span data-rise>{founderCopy.name}</span></span>
          </h2>
          <span class="role" data-fade>{founderCopy.role}</span>
        </div>
      </div>
    </div>
    <p class="bio" data-fade>{founderCopy.bio}</p>
  </div>
</section>

<style>
  .founder {
    position: relative;
    background: var(--page);
    padding: 0 var(--gutter-card) 72px;
  }
  .card {
    max-width: 1560px;
    margin: 0 auto;
    background: #fff;
    border-radius: var(--radius-section);
    box-shadow: var(--shadow-card);
    box-sizing: border-box;
    padding: 32px var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  .identity {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2vw, 32px);
  }
  .avatar {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-periwinkle), var(--brand-violet));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .name-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(28px, 8.4vw, 38px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .role {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-micro);
  }
  .bio {
    margin: 0;
    max-width: 36rem;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .name-row { gap: clamp(20px, 1.5vw, 48px); }
    h2 { font-size: clamp(28px, 6.3vw, 57px); }
  }

  @media (min-width: 1200px) {
    .founder { padding: 0 var(--gutter-card) clamp(96px, 16vh, 180px); }
    .card {
      padding: clamp(32px, 5vw, 88px);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
      gap: 48px 6vw;
    }
    .name-row { gap: clamp(20px, 2vw, 32px); }
    .avatar {
      width: clamp(88px, 8vw, 128px);
      height: clamp(88px, 8vw, 128px);
      font-size: clamp(28px, 2.6vw, 40px);
    }
    h2 { font-size: clamp(36px, 4vw, 72px); }
    .bio { font-size: clamp(18px, 1.45vw, 23px); }
  }
</style>
