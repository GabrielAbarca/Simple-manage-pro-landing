---
import { introCopy } from "../../data/home";
---

<div class="intro" data-intro aria-hidden="true">
  <div class="lines" data-intro-lines>
    {
      introCopy.lines.map((line, index) => (
        <div class="line-mask">
          <div data-irise class:list={{ accent: index === 1 }}>{line}</div>
        </div>
      ))
    }
  </div>
  <div class="bottom-row">
    <div class="months" data-intro-months>
      {
        introCopy.months.map((month) => (
          <div class="month" data-month>
            <span>{month}</span>
            <div class="track"><div class="fill" data-month-bar></div></div>
          </div>
        ))
      }
    </div>
    <div class="counter" data-intro-counter>000</div>
  </div>
  <div class="progress"><div data-intro-progress></div></div>
</div>

<style>
  .intro {
    position: absolute;
    inset: 0;
    z-index: 6;
    background: var(--brand-deep);
    color: #fff;
    display: flex;
    flex-direction: column;
    padding: 88px var(--gutter) 28px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-weight: 800;
    font-size: clamp(44px, 13.5vw, 72px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  [data-irise] { transform: translateY(110%); }
  .accent { color: var(--intro-accent); }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .months {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding-bottom: 14px;
  }
  .month {
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0.35;
  }
  .month span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .track {
    width: 22px;
    height: 2px;
    background: rgba(255, 255, 255, 0.22);
  }
  .fill,
  .progress > div {
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  /* Poppins has no tabular figures: this fixed width (widest value "044") and
     right align stop the counter shifting layout on every frame. */
  .counter {
    min-width: 1.9em;
    text-align: right;
    margin-left: auto;
    font-size: clamp(80px, 26vw, 120px);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.12);
  }
  .progress > div { background: var(--brand-violet); }

  @media (min-width: 768px) {
    .lines { font-size: clamp(44px, 10.13vw, 108px); }
    .counter { font-size: clamp(80px, 19.5vw, 180px); }
  }

  @media (min-width: 1200px) {
    .intro { padding: 96px 4vw 32px; }
    .lines { font-size: clamp(64px, 11vw, 210px); }
    .months { gap: 14px; }
    .track { width: 40px; }
    .counter { font-size: clamp(96px, 16vw, 280px); }
  }
</style>
