---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import type { ContactCardContent } from "../../data/contacto";

interface Props {
  card: ContactCardContent;
  spansTabletRow?: boolean;
}

const { card, spansTabletRow = false } = Astro.props;
const { primaryAction, copyButton } = card;
const externalLinkAttributes = primaryAction.external ? { target: "_blank", rel: "noopener" } : {};
---

<div class:list={["card", { "spans-tablet-row": spansTabletRow }]} data-fade>
  <div class="top">
    <span class="badge" aria-hidden="true"><Icon name={card.icon} color="#fff" size="1.6rem" /></span>
    <span class="number">{card.number}</span>
  </div>
  <div class="intro">
    <h2>{card.title}</h2>
    <p>{card.description}</p>
  </div>
  <div class="value-block">
    <span class="value-label">{card.valueLabel}</span>
    {
      card.valueHref ? (
        <a
          class:list={["value", { numeric: card.valueIsNumeric, "wraps-anywhere": card.valueWrapsAnywhere }]}
          href={card.valueHref}
        >
          {card.value}
        </a>
      ) : (
        <span class="value">{card.value}</span>
      )
    }
  </div>
  <div class="actions">
    <a
      class:list={["pill", "pill-primary", { "with-rule": primaryAction.withRule }]}
      href={primaryAction.href}
      {...externalLinkAttributes}
    >
      {primaryAction.label}
      {primaryAction.withRule && <span class="rule" aria-hidden="true" />}
    </a>
    {
      copyButton && (
        <Button
          variant="ghost"
          icon="content_copy"
          aria-label={copyButton.accessibleLabel}
          data-copy-value={copyButton.value}
          data-js-only
        >
          {copyButton.label}
        </Button>
      )
    }
  </div>
</div>

<style>
  .card {
    background: #fff;
    border-radius: var(--radius-contact);
    box-shadow: var(--shadow-card);
    box-sizing: border-box;
    padding: 24px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-periwinkle), var(--brand-violet));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .number {
    font-size: 14px;
    font-weight: 700;
    color: var(--brand-text);
    font-variant-numeric: tabular-nums;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .value-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .value-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-micro);
  }
  .value {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  a.value:hover { color: var(--brand-text); }
  .numeric { font-variant-numeric: tabular-nums; }
  .wraps-anywhere { overflow-wrap: anywhere; }
  .actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .with-rule { --pill-gap: 12px; }
  .rule {
    width: 24px;
    height: 1px;
    background: currentColor;
  }

  @media (min-width: 768px) {
    .spans-tablet-row { grid-column: 1 / -1; }
  }

  @media (min-width: 1200px) {
    .card {
      padding: clamp(28px, 2.6vw, 44px);
      gap: 28px;
    }
    .spans-tablet-row { grid-column: auto; }
    h2 { font-size: clamp(24px, 1.9vw, 30px); }
    .value { font-size: clamp(22px, 1.9vw, 30px); }
  }
</style>
