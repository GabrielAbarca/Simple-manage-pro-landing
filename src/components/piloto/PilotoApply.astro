---
import { DEMO_URL, mailtoHref, waHref } from "../../config";
import { applyCopy } from "../../data/piloto";
import ApplicationConfirmation from "./form/ApplicationConfirmation.astro";
import ApplicationForm from "./form/ApplicationForm.astro";
---

<section class="apply" id="postular" data-screen-label="05 Postular" data-rv>
  <div class="card">
    <div class="text">
      <h2>
        {
          applyCopy.headline.map((line, i) => (
            <span class="line-mask">
              <span data-rise class:list={{ accent: i === applyCopy.headline.length - 1 }}>{line}</span>
            </span>
          ))
        }
      </h2>
      <p data-fade>{applyCopy.lead}</p>
      <div class="ctas" data-fade>
        <a class="pill pill-lg pill-primary" href={waHref()} target="_blank" rel="noopener">{applyCopy.whatsappCta}</a>
        <a class="pill pill-lg pill-outline" href={mailtoHref()}>{applyCopy.emailCta}</a>
        <a class="text-rule rule-after" href={DEMO_URL} target="_blank" rel="noopener">{applyCopy.demoCta}</a>
      </div>
    </div>
    <ApplicationConfirmation />
    <ApplicationForm />
  </div>
</section>

<style>
  .apply {
    position: relative;
    background: var(--page);
    padding: 0 var(--gutter-card) 56px;
  }
  .card {
    max-width: 1560px;
    margin: 0 auto;
    background: #fff;
    border-radius: var(--radius-section);
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 8px;
    box-sizing: border-box;
  }
  .text {
    padding: 32px 16px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }
  h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(36px, 10.5vw, 50px);
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .accent { color: var(--brand-text); }
  p {
    margin: 0;
    max-width: 30rem;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .ctas > a { justify-content: center; }

  @media (min-width: 768px) {
    .text { padding: 45px 36px 34px; }
    h2 { font-size: clamp(36px, 7.88vw, 75px); }
    p {
      font-size: 18px;
      line-height: 1.6;
    }
    .ctas {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }
  }

  @media (min-width: 1200px) {
    .apply { padding: clamp(32px, 6vh, 72px) 2vw clamp(64px, 10vh, 120px); }
    .card {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
      gap: 16px;
      padding: 16px;
    }
    .text {
      padding: clamp(28px, 5vw, 80px);
      gap: 36px;
    }
    h2 {
      font-size: clamp(44px, 5.2vw, 96px);
      line-height: 0.95;
    }
    p {
      font-size: clamp(16px, 1.25vw, 19px);
      line-height: 1.6;
    }
    .ctas { gap: 12px 20px; }
    .ctas > a { justify-content: normal; }
  }
</style>
