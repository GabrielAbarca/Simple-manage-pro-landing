---
import { faqCopy } from "../../data/piloto";
import Eyebrow from "./Eyebrow.astro";
---

<section
  class="faq-section"
  id="preguntas-frecuentes"
  aria-label={faqCopy.eyebrow}
  data-screen-label="06 Preguntas frecuentes"
  data-rv
>
  <div class="inner">
    <Eyebrow label={faqCopy.eyebrow} rises />
    <div class="faq" data-fade>
      {
        faqCopy.items.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{item.question}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 6 8 10.5 12.5 6" />
              </svg>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative;
    background: var(--page);
    padding: 16px var(--gutter) 72px;
  }
  .inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .faq {
    display: grid;
    gap: 16px;
    align-content: start;
    max-width: 864px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--hairline-card);
    border-radius: 12.8px;
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 25.6px;
    cursor: pointer;
    font-weight: 700;
    font-size: 16.32px;
    line-height: 1.6;
    color: var(--ink);
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--brand-text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-item[open] summary svg {
    rotate: 180deg;
  }
  .faq p {
    margin: 0;
    padding: 0 25.6px 25.6px;
    font-size: 15.68px;
    line-height: 1.6;
    color: var(--ink-muted-strong);
    text-wrap: pretty;
  }

  @media (min-width: 1200px) {
    .faq-section { padding: clamp(32px, 6vh, 72px) 4vw clamp(96px, 16vh, 180px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq summary svg { transition: none; }
  }
</style>
