---
// One field's column: label, control, error. `data-field` names the field for
// the controller, which flips `data-invalid` (the scroll-to-first-error hook)
// alongside aria-invalid on the control itself.
import type { HTMLAttributes } from "astro/types";
import type { FieldName } from "../../../lib/postular/validate";

interface Props extends HTMLAttributes<"div"> {
  name?: FieldName;
  /** Spans the whole field grid, as the design does for wide controls. */
  fullRow?: boolean;
}

const { name, fullRow = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={["form-field", { "full-row": fullRow }, className]}
  data-field={name}
  data-invalid={name ? "false" : undefined}
  {...rest}
>
  <slot />
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .full-row { grid-column: 1 / -1; }
</style>
