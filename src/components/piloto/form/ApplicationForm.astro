---
import { POSTULAR_ENDPOINT, formCopy } from "../../../data/postulacion";
import FieldsetComments from "./FieldsetComments.astro";
import FieldsetContact from "./FieldsetContact.astro";
import FieldsetSchool from "./FieldsetSchool.astro";
import FormFooter from "./FormFooter.astro";
---

<form class="application" action={POSTULAR_ENDPOINT} method="post" data-postulacion-form>
  <div class="intro">
    <h3>{formCopy.title}</h3>
    <p>{formCopy.intro}</p>
  </div>
  <FieldsetSchool />
  <FieldsetContact />
  <FieldsetComments />
  <FormFooter />
  <div class="visually-hidden" aria-hidden="true">
    <label for="pf-website">{formCopy.honeypotLabel}</label>
    <input id="pf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
</form>

<style>
  .application {
    margin: 0;
    border-radius: var(--radius-panel);
    background: #fff;
    border: 1px solid var(--hairline);
    box-sizing: border-box;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    margin: 0;
    font-size: clamp(22px, 1.7vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .application { padding: 34px 36px; }
    h3 { font-size: clamp(22px, 1.27vw, 42px); }
  }

  @media (min-width: 1200px) {
    .application {
      padding: clamp(28px, 3.6vw, 56px);
      gap: 36px;
    }
    h3 { font-size: clamp(22px, 1.7vw, 28px); }
  }
</style>
