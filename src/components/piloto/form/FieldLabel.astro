---
import { formCopy } from "../../../data/postulacion";

interface Props {
  text: string;
  for?: string;
  id?: string;
  optional?: boolean;
}

const { text, for: controlId, id, optional = false } = Astro.props;
const Tag = controlId ? "label" : "span";
---

<Tag class="field-label" for={controlId} id={id}
  >{text}{optional && " "}{optional && <span class="hint">{formCopy.optionalHint}</span>}</Tag
>

<style>
  .field-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-dark-variant);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .hint {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-info-dark);
  }
</style>
