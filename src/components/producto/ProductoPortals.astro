---
// The three portals with live UI. A sticky full-viewport WebGL layer sits
// behind the panels (margin-bottom: -100vh, so it takes no space) and each
// 3D object follows its panel's anchor as the content scrolls over it.
// Panel text and UI parallax are scroll-linked (src/scripts/producto/
// portal-dom.ts), not the layout's one-shot reveal, hence their own
// data-scroll-* attributes and the start states gated below.
import PortalsIntro from "./PortalsIntro.astro";
import PortalPanel from "./PortalPanel.astro";
import PortalsEnd from "./PortalsEnd.astro";
import AdminConsole from "./AdminConsole.astro";
import TeacherConsole from "./TeacherConsole.astro";
import StudentConsole from "./StudentConsole.astro";
import { portalPanels, portalsIntroCopy } from "../../data/producto";
---

<section class="portals" data-screen-label="Portales" data-portals>
  <div class="fade" aria-hidden="true"></div>
  <div class="sticky-layer">
    <div class="stage" data-stage data-portals-stage aria-hidden="true"></div>
    <div class="rail" data-portals-rail data-js-only aria-hidden="true">
      <span class="rail-current" data-portals-rail-number>{portalsIntroCopy.railFirst}</span>
      <div class="rail-track"><div class="rail-fill" data-portals-rail-fill></div></div>
      <span class="rail-last">{portalsIntroCopy.railLast}</span>
    </div>
  </div>
  <div class="content">
    <PortalsIntro />
    <PortalPanel index={0} copy={portalPanels[0]}><AdminConsole /></PortalPanel>
    <PortalPanel index={1} copy={portalPanels[1]}><TeacherConsole /></PortalPanel>
    <PortalPanel index={2} copy={portalPanels[2]}><StudentConsole /></PortalPanel>
    <PortalsEnd />
  </div>
</section>

<style>
  .portals {
    position: relative;
    z-index: 2;
    background: var(--page);
  }
  .fade {
    position: absolute;
    left: 0;
    right: 0;
    top: -28vh;
    height: 28vh;
    background: linear-gradient(rgba(246, 246, 249, 0), #f6f6f9);
    pointer-events: none;
  }
  .sticky-layer {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    z-index: 0;
    pointer-events: none;
  }
  .stage {
    position: absolute;
    inset: 0;
  }
  .rail { display: none; }
  .rail-current {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .rail-track {
    width: 2px;
    height: 160px;
    background: var(--hairline);
    border-radius: 2px;
    overflow: hidden;
  }
  .rail-fill {
    width: 100%;
    height: 100%;
    background: var(--brand-text);
    transform: scaleY(0);
    transform-origin: top;
  }
  .rail-last {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-micro);
  }
  .content {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1200px) {
    .rail {
      position: absolute;
      right: 4vw;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      opacity: 0;
      transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  /* Start states for the scroll-linked lines, armed only when the visitor
     gets motion; portal-dom.ts writes every later frame inline. */
  :global(html.motion [data-portals] [data-scroll-rise]),
  :global(html.motion [data-portals] [data-panel-ui]) { opacity: 0; }
  :global(html.motion [data-portals] [data-scroll-mask]) { transform: translateY(110%); }
</style>
