      {
        "selector": "JSXOpeningElement[name.name='TodayCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|subject|meta|accent|actions|style|key|ref|className|style|children)$/]",
        "message": "<TodayCard> doesn't accept that prop. Declared props: start, end, subject, meta, accent, actions, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
